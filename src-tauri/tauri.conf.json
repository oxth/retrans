{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Retrans",
  "version": "0.5.1",
  "identifier": "com.retrans.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Retrans",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyOTgyNUU1Q0U5NzBGQTYKUldTbUQ1Zk81U1dZUW9VZXc1WTVNOTJUM21WQ3czMmNwbFhCU2JzT25pb29hNlcxVmQzZEY4dmMK",
      "endpoints": [
        "https://github.com/oxth/retrans/releases/latest/download/latest.json"
      ]
    }
  }
}
